{
  "name": "proxy-climb-test-harness",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic CPU-first regression harness for the shooting game",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/cpu.test.cjs",
    "test:cpu": "node --test --test-concurrency=1 tests/cpu.test.cjs",
    "test:full": "node --test --test-concurrency=1 tests/full-world.test.cjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser.test.cjs",
    "test:stress": "node --test --test-concurrency=1 tests/stress.test.cjs",
    "test:all": "node tests/run-all.cjs",
    "test:bench": "node tests/benchmark.cjs",
    "test:collapse-perf": "node tests/collapse-performance.cjs",
    "test:rapid-fire-perf": "node tests/rapid-fire-performance.cjs"
  },
  "devDependencies": {
    "playwright-core": "1.62.1",
    "three": "0.128.0"
  }
}
